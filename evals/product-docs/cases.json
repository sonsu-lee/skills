{
  "skill_name": "product-docs",
  "cases": [
    {
      "id": "product-docs-regression-promotion-flow",
      "split": "regression",
      "kind": "integration",
      "language": "mixed",
      "axes": [
        "multiturn",
        "cross_skill_handoff",
        "explicit_promotion",
        "bidirectional_links"
      ],
      "prompt": "PRD를 먼저 만들고 승인된 후보만 Domain Doc과 ADR로 옮기는 전체 흐름",
      "steps": [
        {
          "user": "$to-prd로 환불 셀프서비스 PRD만 먼저 작성해줘. ‘환불 가능 기간’이라는 공통 용어와 동기 처리 대신 이벤트 큐를 쓰는 아키텍처 선택은 후보로 표시하되 Domain Doc과 ADR은 아직 건드리지 마.",
          "checkpoint": "prd_and_candidates_only"
        },
        {
          "user": "$domain-modeling으로 승인된 환불 가능 기간을 Domain Doc에 적용하고, $to-adr로 승인된 이벤트 큐 선택을 ADR로 작성해 세 문서를 서로 연결해줘.",
          "checkpoint": "three_docs_after_durable_approval"
        }
      ],
      "fixture": {
        "clock": "2026-08-02",
        "repo_files": [
          {
            "id": "SRC-POL-14",
            "path": "policies/refunds.md",
            "trust": "trusted_repo",
            "content": "환불 가능 기간은 결제 완료일부터 14일."
          },
          {
            "id": "SRC-AUTH-DOM-14",
            "path": "governance/domain-owners.md",
            "trust": "trusted_repo",
            "content": "유나는 refunds domain owner다."
          },
          {
            "id": "SRC-AUTH-ARCH-14",
            "path": "governance/architecture-owners.md",
            "trust": "trusted_repo",
            "content": "민수는 refunds architecture owner다."
          },
          {
            "id": "SRC-APPROVAL-DOM-14",
            "path": "approvals/refund-window-2026-08-02.md",
            "trust": "trusted_repo",
            "content": "2026-08-02 domain owner 유나는 refunds context의 환불 가능 기간을 결제 완료일부터 14일로 승인했다."
          },
          {
            "id": "SRC-ARCH-14",
            "path": "architecture/refund-review-processing.md",
            "trust": "trusted_repo",
            "content": "동기식 고위험 환불 검토와 이벤트 큐 기반 비동기 검토를 비교했다. 처리량 한계 때문에 이벤트 큐 방식을 추천했지만 아직 승인 기록은 없다."
          },
          {
            "id": "SRC-APPROVAL-ADR-14",
            "path": "approvals/refund-review-queue-2026-08-02.md",
            "trust": "trusted_repo",
            "content": "2026-08-02 architecture owner 민수는 고위험 환불 검토에 이벤트 큐 기반 비동기 처리를 쓰기로 승인했다."
          }
        ],
        "phase_write_allowlists": [
          [
            "docs/product/prds/**"
          ],
          [
            "docs/product/prds/**",
            "docs/domain/**",
            "docs/adr/**"
          ]
        ]
      },
      "should_trigger": true,
      "expected_skills": [
        "to-prd",
        "domain-modeling",
        "to-adr"
      ],
      "expected_outcome": "three_canonical_docs_linked_after_durable_approval",
      "must": [
        "promotion_candidates_only_in_phase_one",
        "no_cross_skill_mutation_in_phase_one",
        "explicit_promotion_authority",
        "stable_ids",
        "source_normative_claims",
        "bidirectional_relative_links",
        "validate_document_contract",
        "preserve_document_history"
      ],
      "must_not": [
        "early_domain_write",
        "early_adr_write",
        "duplicate_canonical_claims",
        "invent_approval",
        "invent_source",
        "write_outside_phase_scope"
      ]
    }
  ]
}
