{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sonsu:skills:develop-change:orchestration:v1",
  "title": "develop-change orchestration record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "objective",
    "scope",
    "decisions",
    "effect_binding",
    "primary_route",
    "route_plan",
    "profile",
    "gate",
    "foundation_binding",
    "skill_resolution",
    "authorization",
    "verification",
    "handoff"
  ],
  "properties": {
    "contract_version": {
      "const": "develop-change-orchestration-v1"
    },
    "objective": {"$ref": "#/$defs/objective"},
    "scope": {"$ref": "#/$defs/scope"},
    "decisions": {
      "type": "array",
      "items": {"$ref": "#/$defs/decision"}
    },
    "effect_binding": {"$ref": "#/$defs/effectBinding"},
    "primary_route": {"$ref": "#/$defs/route"},
    "route_plan": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/route"}
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "confidence"],
      "properties": {
        "level": {"enum": ["direct", "bounded", "architectural"]},
        "confidence": {"enum": ["confirmed", "provisional"]}
      },
      "allOf": [
        {
          "if": {
            "properties": {"level": {"const": "direct"}},
            "required": ["level"]
          },
          "then": {
            "properties": {"confidence": {"const": "confirmed"}}
          }
        }
      ]
    },
    "gate": {"$ref": "#/$defs/gate"},
    "foundation_binding": {"$ref": "#/$defs/foundationBinding"},
    "skill_resolution": {"$ref": "#/$defs/skillResolution"},
    "authorization": {"$ref": "#/$defs/authorizationSnapshot"},
    "verification": {"$ref": "#/$defs/verification"},
    "handoff": {"$ref": "#/$defs/handoff"}
  },
  "allOf": [
    {
      "if": {"properties": {"primary_route": {"const": "understand"}}},
      "then": {"properties": {"route_plan": {"contains": {"const": "understand"}}}}
    },
    {
      "if": {"properties": {"primary_route": {"const": "shape"}}},
      "then": {"properties": {"route_plan": {"contains": {"const": "shape"}}}}
    },
    {
      "if": {"properties": {"primary_route": {"const": "decide"}}},
      "then": {"properties": {"route_plan": {"contains": {"const": "decide"}}}}
    },
    {
      "if": {"properties": {"primary_route": {"const": "design"}}},
      "then": {"properties": {"route_plan": {"contains": {"const": "design"}}}}
    },
    {
      "if": {"properties": {"primary_route": {"const": "diagnose"}}},
      "then": {"properties": {"route_plan": {"contains": {"const": "diagnose"}}}}
    },
    {
      "if": {"properties": {"primary_route": {"const": "change"}}},
      "then": {"properties": {"route_plan": {"contains": {"const": "change"}}}}
    },
    {
      "if": {"properties": {"primary_route": {"const": "verify"}}},
      "then": {"properties": {"route_plan": {"contains": {"const": "verify"}}}}
    },
    {
      "if": {"properties": {"primary_route": {"const": "deliver"}}},
      "then": {"properties": {"route_plan": {"contains": {"const": "deliver"}}}}
    },
    {
      "if": {"properties": {"primary_route": {"const": "operate"}}},
      "then": {"properties": {"route_plan": {"contains": {"const": "operate"}}}}
    },
    {
      "if": {"properties": {"primary_route": {"const": "evolve"}}},
      "then": {"properties": {"route_plan": {"contains": {"const": "evolve"}}}}
    },
    {
      "if": {
        "properties": {
          "profile": {
            "properties": {"confidence": {"const": "provisional"}},
            "required": ["confidence"]
          }
        }
      },
      "then": {
        "properties": {
          "gate": {
            "properties": {"result": {"enum": ["conditional", "blocked"]}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "skill_resolution": {
            "properties": {"status": {"const": "blocked"}},
            "required": ["status"]
          }
        }
      },
      "then": {
        "properties": {
          "gate": {"properties": {"result": {"const": "blocked"}}}
        }
      }
    },
    {
      "if": {
        "properties": {
          "gate": {
            "properties": {"result": {"const": "blocked"}},
            "required": ["result"]
          }
        }
      },
      "then": {
        "properties": {
          "handoff": {
            "properties": {
              "next_action": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "route": {
      "enum": [
        "understand",
        "shape",
        "decide",
        "design",
        "diagnose",
        "change",
        "verify",
        "deliver",
        "operate",
        "evolve"
      ]
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "finish_line"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "finish_line": {"type": "string", "minLength": 1}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "exclude"],
      "properties": {
        "include": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "exclude": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "reason", "reconsider_when"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "reconsider_when": {"type": ["string", "null"]}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "blockers", "assumptions"],
      "properties": {
        "result": {"enum": ["pass", "conditional", "blocked"]},
        "blockers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "assumptions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/assumption"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {"enum": ["pass", "conditional"]}
            }
          },
          "then": {
            "properties": {
              "blockers": {"maxItems": 0}
            }
          }
        },
        {
          "if": {
            "properties": {
              "result": {"const": "pass"}
            }
          },
          "then": {
            "properties": {
              "assumptions": {"maxItems": 0}
            }
          }
        },
        {
          "if": {
            "properties": {
              "result": {"const": "conditional"}
            }
          },
          "then": {
            "properties": {
              "assumptions": {"minItems": 1}
            }
          }
        },
        {
          "if": {
            "properties": {
              "result": {"const": "blocked"}
            }
          },
          "then": {
            "properties": {
              "blockers": {"minItems": 1},
              "assumptions": {"maxItems": 0}
            }
          }
        }
      ]
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "basis_refs", "validation"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "basis_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "validation": {"type": "string", "minLength": 1}
      }
    },
    "foundationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_ref",
        "frontier_ref",
        "authorization_record",
        "authorization_evaluation"
      ],
      "properties": {
        "gate_ref": {
          "$ref": "urn:sonsu:codex-workflow:schema:phase1-foundation-draft-v1#/$defs/identityRef"
        },
        "frontier_ref": {
          "$ref": "urn:sonsu:codex-workflow:schema:phase1-foundation-draft-v1#/$defs/identityRef"
        },
        "authorization_record": {
          "oneOf": [
            {
              "$ref": "urn:sonsu:codex-workflow:schema:phase1-foundation-draft-v1#/$defs/authorizationRecord"
            },
            {"type": "null"}
          ]
        },
        "authorization_evaluation": {
          "oneOf": [
            {
              "$ref": "urn:sonsu:codex-workflow:schema:phase1-foundation-draft-v1#/$defs/authorizationEvaluation"
            },
            {"type": "null"}
          ]
        }
      }
    },
    "effectBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_task_id", "target_fingerprint", "basis_fingerprint"],
      "properties": {
        "logical_task_id": {
          "$ref": "urn:sonsu:codex-workflow:schema:phase1-foundation-draft-v1#/$defs/stableId"
        },
        "target_fingerprint": {
          "$ref": "urn:sonsu:codex-workflow:schema:phase1-foundation-draft-v1#/$defs/sha256"
        },
        "basis_fingerprint": {
          "$ref": "urn:sonsu:codex-workflow:schema:phase1-foundation-draft-v1#/$defs/sha256"
        }
      }
    },
    "skillResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "decisions", "planned_capabilities", "fallback"],
      "properties": {
        "status": {"enum": ["pass", "blocked"]},
        "decisions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/skillDecision"}
        },
        "planned_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/plannedCapability"}
        },
        "fallback": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decisions": {
                "contains": {
                  "properties": {"decision": {"const": "blocked"}},
                  "required": ["decision"]
                }
              }
            },
            "required": ["decisions"]
          },
          "then": {
            "properties": {"status": {"const": "blocked"}}
          }
        }
      ]
    },
    "skillDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_id",
        "source",
        "decision",
        "reason",
        "responsibility",
        "specificity",
        "compatible",
        "required_tools",
        "applies_to_routes",
        "effect_boundary"
      ],
      "properties": {
        "skill_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?::[a-z0-9]+(?:-[a-z0-9]+)*)?$"
        },
        "source": {"enum": ["user_named", "repository", "installed"]},
        "decision": {"enum": ["selected", "composed", "rejected", "blocked"]},
        "reason": {"type": "string", "minLength": 1},
        "responsibility": {"type": "string", "minLength": 1},
        "specificity": {"type": "integer", "minimum": 0, "maximum": 5},
        "compatible": {"type": "boolean"},
        "required_tools": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "applies_to_routes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/route"}
        },
        "effect_boundary": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {"enum": ["selected", "composed"]}
            },
            "required": ["decision"]
          },
          "then": {
            "properties": {"compatible": {"const": true}}
          }
        }
      ]
    },
    "plannedCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "status"],
      "properties": {
        "capability_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "status": {"const": "planned"}
      }
    },
    "authorizationSnapshot": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/authorizationSummary"}
    },
    "authorizationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "authorization_ref",
        "target_fingerprint",
        "scope_fingerprint",
        "basis_fingerprint",
        "status",
        "runtime_eligible"
      ],
      "properties": {
        "capability": {
          "$ref": "urn:sonsu:codex-workflow:schema:phase1-foundation-draft-v1#/$defs/capability"
        },
        "authorization_ref": {
          "$ref": "urn:sonsu:codex-workflow:schema:phase1-foundation-draft-v1#/$defs/identityRef"
        },
        "target_fingerprint": {
          "$ref": "urn:sonsu:codex-workflow:schema:phase1-foundation-draft-v1#/$defs/sha256"
        },
        "scope_fingerprint": {
          "$ref": "urn:sonsu:codex-workflow:schema:phase1-foundation-draft-v1#/$defs/sha256"
        },
        "basis_fingerprint": {
          "$ref": "urn:sonsu:codex-workflow:schema:phase1-foundation-draft-v1#/$defs/sha256"
        },
        "status": {
          "enum": [
            "not_applicable",
            "not_granted",
            "granted",
            "denied",
            "withdrawn",
            "stale"
          ]
        },
        "runtime_eligible": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {"const": "granted"}
            }
          },
          "then": {
            "properties": {
              "runtime_eligible": {"const": true}
            }
          },
          "else": {
            "properties": {
              "runtime_eligible": {"const": false}
            }
          }
        }
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failed", "not_run"],
      "properties": {
        "passed": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "failed": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "not_run": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "scope",
        "completed_phase",
        "decisions",
        "artifacts",
        "effect_binding",
        "profile",
        "foundation_binding",
        "skill_resolution",
        "authorization",
        "verification",
        "blockers",
        "next_action"
      ],
      "properties": {
        "objective": {"$ref": "#/$defs/objective"},
        "scope": {"$ref": "#/$defs/scope"},
        "completed_phase": {
          "oneOf": [
            {"$ref": "#/$defs/route"},
            {"type": "null"}
          ]
        },
        "decisions": {
          "type": "array",
          "items": {"$ref": "#/$defs/decision"}
        },
        "artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "effect_binding": {"$ref": "#/$defs/effectBinding"},
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "confidence"],
          "properties": {
            "level": {"enum": ["direct", "bounded", "architectural"]},
            "confidence": {"enum": ["confirmed", "provisional"]}
          }
        },
        "foundation_binding": {"$ref": "#/$defs/foundationBinding"},
        "skill_resolution": {"$ref": "#/$defs/skillResolution"},
        "authorization": {"$ref": "#/$defs/authorizationSnapshot"},
        "verification": {"$ref": "#/$defs/verification"},
        "blockers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "next_action": {"type": ["string", "null"]}
      }
    }
  }
}
