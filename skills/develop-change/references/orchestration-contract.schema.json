{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sonsu:skills:develop-change:orchestration:v1",
  "title": "develop-change orchestration record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "objective",
    "scope",
    "decisions",
    "primary_route",
    "route_plan",
    "profile",
    "gate",
    "skill_resolution",
    "authorization",
    "verification",
    "handoff"
  ],
  "properties": {
    "contract_version": {
      "const": "develop-change-orchestration-v1"
    },
    "objective": {"$ref": "#/$defs/objective"},
    "scope": {"$ref": "#/$defs/scope"},
    "decisions": {
      "type": "array",
      "items": {"$ref": "#/$defs/decision"}
    },
    "primary_route": {"$ref": "#/$defs/route"},
    "route_plan": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/route"}
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "confidence"],
      "properties": {
        "level": {"enum": ["direct", "bounded", "architectural"]},
        "confidence": {"enum": ["confirmed", "provisional"]}
      }
    },
    "gate": {"$ref": "#/$defs/gate"},
    "skill_resolution": {"$ref": "#/$defs/skillResolution"},
    "authorization": {"$ref": "#/$defs/authorizationSnapshot"},
    "verification": {"$ref": "#/$defs/verification"},
    "handoff": {"$ref": "#/$defs/handoff"}
  },
  "$defs": {
    "route": {
      "enum": [
        "understand",
        "shape",
        "decide",
        "design",
        "diagnose",
        "change",
        "verify",
        "deliver",
        "operate",
        "evolve"
      ]
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "finish_line"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "finish_line": {"type": "string", "minLength": 1}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "exclude"],
      "properties": {
        "include": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "exclude": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "reason", "reconsider_when"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "reconsider_when": {"type": ["string", "null"]}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "blockers"],
      "properties": {
        "result": {"enum": ["pass", "conditional", "blocked"]},
        "blockers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {"enum": ["pass", "conditional"]}
            }
          },
          "then": {
            "properties": {
              "blockers": {"maxItems": 0}
            }
          }
        },
        {
          "if": {
            "properties": {
              "result": {"const": "blocked"}
            }
          },
          "then": {
            "properties": {
              "blockers": {"minItems": 1}
            }
          }
        }
      ]
    },
    "skillResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "decisions", "planned_capabilities", "fallback"],
      "properties": {
        "status": {"enum": ["pass", "blocked"]},
        "decisions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/skillDecision"}
        },
        "planned_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/plannedCapability"}
        },
        "fallback": {"type": ["string", "null"]}
      }
    },
    "skillDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_id",
        "source",
        "decision",
        "reason",
        "responsibility",
        "specificity",
        "compatible",
        "required_tools",
        "applies_to_routes",
        "effect_boundary"
      ],
      "properties": {
        "skill_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?::[a-z0-9]+(?:-[a-z0-9]+)*)?$"
        },
        "source": {"enum": ["user_named", "repository", "installed"]},
        "decision": {"enum": ["selected", "composed", "rejected", "blocked"]},
        "reason": {"type": "string", "minLength": 1},
        "responsibility": {"type": "string", "minLength": 1},
        "specificity": {"type": "integer", "minimum": 0, "maximum": 5},
        "compatible": {"type": "boolean"},
        "required_tools": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "applies_to_routes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/route"}
        },
        "effect_boundary": {"type": "string", "minLength": 1}
      }
    },
    "plannedCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "status"],
      "properties": {
        "capability_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "status": {"const": "planned"}
      }
    },
    "authorizationSnapshot": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/authorizationSummary"}
    },
    "authorizationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "authorization_ref",
        "target_fingerprint",
        "scope_fingerprint",
        "basis_fingerprint",
        "status",
        "runtime_eligible"
      ],
      "properties": {
        "capability": {
          "$ref": "urn:sonsu:codex-workflow:schema:phase1-foundation-draft-v1#/$defs/capability"
        },
        "authorization_ref": {
          "$ref": "urn:sonsu:codex-workflow:schema:phase1-foundation-draft-v1#/$defs/identityRef"
        },
        "target_fingerprint": {
          "$ref": "urn:sonsu:codex-workflow:schema:phase1-foundation-draft-v1#/$defs/sha256"
        },
        "scope_fingerprint": {
          "$ref": "urn:sonsu:codex-workflow:schema:phase1-foundation-draft-v1#/$defs/sha256"
        },
        "basis_fingerprint": {
          "$ref": "urn:sonsu:codex-workflow:schema:phase1-foundation-draft-v1#/$defs/sha256"
        },
        "status": {
          "enum": [
            "not_applicable",
            "not_granted",
            "granted",
            "denied",
            "withdrawn",
            "stale"
          ]
        },
        "runtime_eligible": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {"const": "granted"}
            }
          },
          "then": {
            "properties": {
              "runtime_eligible": {"const": true}
            }
          },
          "else": {
            "properties": {
              "runtime_eligible": {"const": false}
            }
          }
        }
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failed", "not_run"],
      "properties": {
        "passed": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "failed": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "not_run": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "scope",
        "completed_phase",
        "decisions",
        "artifacts",
        "skill_resolution",
        "authorization",
        "verification",
        "blockers",
        "next_action"
      ],
      "properties": {
        "objective": {"$ref": "#/$defs/objective"},
        "scope": {"$ref": "#/$defs/scope"},
        "completed_phase": {"$ref": "#/$defs/route"},
        "decisions": {
          "type": "array",
          "items": {"$ref": "#/$defs/decision"}
        },
        "artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "skill_resolution": {"$ref": "#/$defs/skillResolution"},
        "authorization": {"$ref": "#/$defs/authorizationSnapshot"},
        "verification": {"$ref": "#/$defs/verification"},
        "blockers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "next_action": {"type": ["string", "null"]}
      }
    }
  }
}
