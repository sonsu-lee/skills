{
  "skill_name": "review-commit",
  "cases": [
    {
      "id": "ko-working-tree-preflight",
      "language": "ko",
      "prompt": "현재 staged와 unstaged 변경을 커밋 전에 감사해줘. 파일은 건드리지 마.",
      "fixture": {
        "git_state": {
          "head": "1111111111111111111111111111111111111111",
          "staged": [
            "src/auth.ts",
            "test/auth.test.ts"
          ],
          "unstaged": [
            "README.md"
          ],
          "untracked": [
            "notes.txt"
          ]
        },
        "diff_summary": {
          "src/auth.ts": "passkey sign-in implementation",
          "test/auth.test.ts": "passkey tests",
          "README.md": "unrelated spelling cleanup",
          "notes.txt": "private scratch notes"
        }
      },
      "should_trigger": true,
      "must": [
        "complete_commit_plan",
        "corrected_artifacts",
        "inspect_all_worktree_states",
        "inspect_read_execution_delegates",
        "non_refresh_git_reads",
        "read_only",
        "select_candidate_target",
        "semantic_atomicity"
      ],
      "must_not": [
        "stage",
        "commit",
        "exclude_untracked_silently",
        "expose_private_content"
      ]
    },
    {
      "id": "en-commit-range-audit",
      "language": "en",
      "prompt": "Audit the last three commits for Conventional Commits compliance and atomicity. Do not rewrite history.",
      "fixture": {
        "commits": [
          {
            "sha": "2222222222222222222222222222222222222222",
            "message": "add auth and update docs",
            "changes": [
              "src/auth.ts",
              "docs/api.md"
            ]
          },
          {
            "sha": "3333333333333333333333333333333333333333",
            "message": "test(auth): cover passkey fallback",
            "changes": [
              "test/auth.test.ts"
            ]
          },
          {
            "sha": "4444444444444444444444444444444444444444",
            "message": "fix(auth): reject expired challenges",
            "changes": [
              "src/auth.ts",
              "test/auth.test.ts"
            ]
          }
        ]
      },
      "should_trigger": true,
      "must": [
        "conventional_commit_check",
        "inspect_each_commit_and_range",
        "read_only",
        "replacement_message",
        "select_history_target",
        "semantic_atomicity"
      ],
      "must_not": [
        "rebase",
        "amend",
        "invent_test_results"
      ]
    },
    {
      "id": "mixed-pr-squash-audit",
      "language": "mixed",
      "prompt": "이 PR이 squash merge 가능한 단위인지 preflight 해줘. title/body/template과 full diff까지 check해줘.",
      "fixture": {
        "merge_mode": "squash",
        "squash_merge_commit_title": "PR_TITLE",
        "squash_merge_commit_message": "PR_BODY",
        "pull_request": {
          "number": 42,
          "base_sha": "5555555555555555555555555555555555555555",
          "head_sha": "6666666666666666666666666666666666666666",
          "title": "feat(auth): add passkey sign-in",
          "body": "## Summary\n- Add passkey sign-in\n\n## Verification\n- [x] Tests pass",
          "checks": [
            {
              "name": "test",
              "status": "success",
              "head_sha": "6666666666666666666666666666666666666666"
            }
          ]
        },
        "full_diff_summary": [
          "passkey sign-in implementation",
          "passkey tests"
        ],
        "template": "## Summary\n\n## Verification"
      },
      "should_trigger": false,
      "expected_route": "review-pr"
    },
