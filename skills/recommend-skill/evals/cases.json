      "language": "en",
      "prompt": "Use $recommend-skill to tell me which skill should compare our still-open queue technology options.",
      "should_trigger": true,
      "expected_route": "architecture-decisions",
      "must": [
        "recognize_open_decision",
        "recommend_one_next_skill",
        "provide_exact_invocation"
      ],
      "must_not": [
        "choose_technology",
        "write_adr",
        "auto_invoke_explicit_skill"
      ]
    },
    {
