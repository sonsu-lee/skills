      "kind": "routing",
      "language": "ko",
      "prompt": "$recommend-skill로 승인된 구현 계획을 여러 실행 작업으로 나누려면 무엇을 호출해야 하는지 알려줘.",
      "should_trigger": true,
      "expected_route": "to-tickets",
      "must": [
        "recognize_approved_plan",
        "recommend_one_next_skill",
        "provide_exact_invocation"
      ],
      "must_not": [
        "create_tickets",
        "publish_issues",
        "auto_invoke_explicit_skill"
      ]
    },
    {
