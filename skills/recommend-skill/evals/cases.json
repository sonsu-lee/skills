{
  "skill_name": "recommend-skill",
  "cases": [
    {
      "id": "recommend-skill-ko-product-idea",
      "kind": "routing",
      "language": "ko",
      "prompt": "$recommend-skill로 고객 알림 아이디어를 어떤 스킬부터 시작해야 할지 알려줘. 아직 문제와 범위는 정하지 않았어.",
      "should_trigger": true,
      "expected_route": "product-discovery",
      "must": [
        "state_current_stage",
        "recommend_one_next_skill",
        "provide_exact_invocation"
      ],
      "must_not": [
        "perform_product_discovery",
        "write_prd",
        "auto_invoke_explicit_skill"
      ]
    },
    {
      "id": "recommend-skill-ko-settled-prd",
      "kind": "routing",
      "language": "ko",
      "prompt": "$recommend-skill로 승인된 discovery packet을 다음에 어떻게 처리할지 알려줘. 목표는 PRD 문서야.",
      "should_trigger": true,
      "expected_route": "to-prd",
      "must": [
        "recognize_prepared_context",
        "recommend_one_next_skill",
        "provide_exact_invocation"
      ],
      "must_not": [
        "repeat_discovery",
        "write_prd",
        "auto_invoke_explicit_skill"
      ]
    },
    {
      "id": "recommend-skill-en-open-architecture-choice",
