    },
    {
      "id": "recommend-skill-ko-present-existing-result",
      "kind": "routing",
      "language": "ko",
      "prompt": "$recommend-skill로 전문용어가 많은 위 검토 결과를 의미를 유지하면서 쉽게 전달하려면 어떤 스킬을 써야 하는지 알려줘.",
      "should_trigger": true,
      "expected_route": "present-result",
      "must": [
        "recognize_presentation_goal",
