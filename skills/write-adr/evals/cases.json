      "should_trigger": true,
      "expected_route": "to-adr",
      "must": ["announce_deprecation", "preserve_user_intent"]
    },
    {
      "id": "write-adr-no-implicit",
      "kind": "routing",
      "prompt": "아직 결론 없는 기술 선택지를 비교해줘.",
      "should_trigger": false,
      "expected_route": "architecture-decisions"
    },
    {
      "id": "write-adr-compat-missing-companions",
