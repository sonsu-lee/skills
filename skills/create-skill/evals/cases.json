{
  "skill_name": "create-skill",
  "cases": [
    {
      "id": "ko-explicit-new-skill",
      "language": "ko",
      "prompt": "$create-skill을 사용해서 릴리스 노트를 매주 같은 형식으로 작성하는 새 스킬을 만들어줘.",
      "should_trigger": true,
      "expected_route": "create_new",
      "must": [
        "confirm_single_user_goal",
        "search_existing_skills",
        "create_new_skill_only",
        "validate_structure_and_behavior"
      ],
      "must_not": [
        "modify_existing_skill",
        "combine_independent_goals",
        "skip_behavior_evaluation"
      ]
    },
    {
      "id": "en-explicit-incomplete",
      "language": "en",
      "prompt": "Use $create-skill to turn my recurring API changelog workflow into a reusable Agent Skill. I have not chosen a name or location yet.",
      "should_trigger": true,
      "expected_route": "create_new",
      "must": [
        "derive_single_user_goal",
        "resolve_creation_location",
        "state_safe_assumptions",
        "validate_structure_and_behavior"
      ],
      "must_not": [
        "invent_outcome_changing_requirements",
        "overwrite_existing_target",
        "skip_behavior_evaluation"
      ]
    },
    {
      "id": "mixed-explicit-boundary",
      "language": "mixed",
      "prompt": "$create-skill로 dependency update PR을 준비하는 새 skill을 만들어줘. 기존 skill이 같은 목표를 이미 지원하면 새로 만들지 말고 알려줘.",
      "should_trigger": true,
      "expected_route": "create_new_or_use_existing",
      "must": [
        "search_existing_skills",
        "classify_before_writing",
        "preserve_existing_files",
        "report_route"
      ],
      "must_not": [
        "duplicate_existing_skill",
        "modify_existing_skill",
        "create_before_location_check"
      ]
    },
    {
      "id": "negative-implicit-create",
      "language": "ko",
      "prompt": "반복되는 장애 보고서 작성을 스킬로 만들어줘.",
      "should_trigger": false,
      "expected_route": "built_in_skill_creator",
      "must": [
        "respect_explicit_only_policy"
      ],
      "must_not": [
        "implicit_create_skill_activation"
      ]
    },
    {
      "id": "negative-existing-skill-edit",
      "language": "ko",
      "prompt": "기존 research 스킬의 트리거 설명을 더 넓게 수정해줘.",
      "should_trigger": false,
      "expected_route": "existing_skill_work",
      "must": [
        "route_to_existing_skill_work"
      ],
      "must_not": [
        "create_skill_activation",
        "create_duplicate_skill"
      ]
    },
    {
      "id": "negative-existing-skill-review",
      "language": "en",
      "prompt": "Review the existing research skill and run its trigger evaluations.",
      "should_trigger": false,
      "expected_route": "existing_skill_review",
      "must": [
        "route_to_existing_skill_review"
      ],
      "must_not": [
        "create_skill_activation",
        "create_new_skill"
      ]
    },
    {
      "id": "negative-one-off-task",
      "language": "ko",
      "prompt": "이번 주 릴리스 노트 한 번만 작성해줘.",
      "should_trigger": false,
      "expected_route": "no_skill",
      "must": [
        "handle_as_one_off_task"
      ],
      "must_not": [
        "create_skill_activation",
        "create_new_skill"
      ]
    },
    {
      "id": "holdout-explicit-independent-goals",
      "split": "holdout",
      "language": "ko",
      "prompt": "$create-skill로 이력서 작성과 Git 커밋 생성을 모두 수행하는 스킬 하나를 만들어줘.",
      "should_trigger": true,
      "expected_route": "split_or_compose",
      "must": [
        "detect_independent_goals",
        "split_or_compose_skills",
        "explain_goal_boundaries"
      ],
      "must_not": [
        "combine_independent_goals",
        "create_multi_topic_skill"
      ]
    }
  ]
}
