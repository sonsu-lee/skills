      "expected_mode": "create_then_update",
      "expected_outcome": "corrected_draft_with_persisted_dependent_decision_invalidated",
      "must": [
        "preserve_user_constraints",
        "one_decision_unit",
        "decision_dependency_invalidation",
        "scope_and_non_goals",
        "requirements_and_acceptance",
        "mark_unknowns",
        "workflow_status_conditional",
        "validate_document_contract"
      ],
      "must_not": [
        "invent_success_metric",
        "silently_change_non_goal",
        "claim_unconfirmed_approval",
        "create_duplicate_document",
        "write_outside_phase_scope"
      ]
