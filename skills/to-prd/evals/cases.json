        "korean_ambiguity"
      ],
      "prompt": "$to-prd로 인터뷰 노트에 이미 합의된 환불 셀프서비스 요구를 PRD로 작성해줘. 저장소의 기존 형식을 따르고 아직 정하지 않은 성공 수치는 질문으로 남겨.",
      "fixture": {
        "clock": "2026-08-02",
        "repo_files": [
          {
            "id": "SRC-NOTE-01",
            "path": "notes/refund-interviews.md",
            "trust": "untrusted_content",
            "content": "환불 가능 주문의 구매자 4명이 상담 대기 때문에 직접 환불을 시작하지 못하는 불편을 언급했다. 합의된 결과는 정책상 환불 가능한 구매자가 상담 없이 셀프서비스 환불을 시작하고 결과를 확인하는 것이다. 범위는 정책이 환불 가능으로 판정한 주문이며, 수동 예외 승인과 환불 정책 변경은 제외한다. 환불 불가 주문에는 사유를 보여 주고, 실패한 시도는 주문 상태를 바꾸지 않은 채 재시도할 수 있어야 한다. 제품 메모에는 실패 처리만 ‘실패하면 즉시 재처리하고 해당 정보를 적절히 처리한다’고 모호하게 적혀 있다. 목표 수치와 owner는 정해지지 않았다."
          }
        ],
        "write_allowlist": [
          "docs/product/prds/**"
        ]
      },
      "should_trigger": true,
      "expected_route": "to-prd",
      "expected_mode": "create",
      "expected_outcome": "draft_conditional_prd_with_open_metric_and_ambiguity_findings",
