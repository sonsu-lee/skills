{
  "skill_name": "write-prd",
  "cases": [
    {
      "id": "write-prd-compat-discovery",
      "kind": "routing",
      "language": "ko",
      "prompt": "$write-prd로 아직 정리되지 않은 제품 아이디어를 구체화해줘.",
      "should_trigger": true,
      "expected_route": "product-discovery",
      "must": [
        "announce_deprecation",
        "preserve_user_intent",
        "avoid_future_step_execution"
      ]
    },
    {
      "id": "write-prd-compat-conversion",
      "kind": "routing",
      "language": "ko",
      "prompt": "$write-prd로 승인된 discovery packet을 PRD 파일로 만들어줘.",
      "should_trigger": true,
      "expected_route": "to-prd",
      "must": [
        "announce_deprecation",
        "preserve_user_intent"
      ]
    },
    {
      "id": "write-prd-no-implicit",
      "kind": "routing",
      "language": "ko",
      "prompt": "제품 아이디어의 문제와 범위를 같이 정리해줘.",
      "should_trigger": false,
      "expected_route": "product-discovery"
    }
  ]
}
